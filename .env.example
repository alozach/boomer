# Token du bot Slack (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-token-here

# Secret de signature pour vérifier les requêtes Slack
SLACK_SIGNING_SECRET=your-signing-secret-here

# Token d'app pour le mode Socket (xapp-...) — recommandé pour RPi sans IP publique
SLACK_APP_TOKEN=xapp-your-app-token-here

# IDs Slack des admins (ban, historique, demandes de ban), séparés par des virgules ;
# sans admin, ces commandes sont inutilisables (un warning le rappelle au démarrage)
BOOMER_ADMINS=

